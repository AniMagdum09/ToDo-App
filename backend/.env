# Copy this file to .env and fill your values

# PostgreSQL connection string
# Format: postgresql://username:password@host/database_name
DATABASE_URL=postgresql://postgres:yourpassword@localhost/tododb

# JWT Secret Key — any long random string (used to sign tokens)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here-change-this

# How long JWT tokens live (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
